OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Calls: "mock" uses the simulator on the Calls page, "plivo" places real calls.
CALL_PROVIDER=mock
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
# Public https address Plivo can reach (for example from `ngrok http 8000`). Changes when ngrok restarts.
PUBLIC_BASE_URL=

# Voice (ElevenLabs). Leave empty to use the Plivo voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Test invitation emails (Gmail: smtp.gmail.com, port 587, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Kripa HR
